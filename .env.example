# Copy to .env.local and fill in Group-15 values.
# Do not put real keys in this file.
# Harborline client/server code reads these NEXT_PUBLIC_ names.

NEXT_PUBLIC_SUPABASE_URL=https://xubpljmqxuoqbldivtxk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key-here

# Optional Stripe test mode (PCI SAQ A). When unset, Payments uses a
# simulated processor frame that never collects PAN/CVV in Harborline UI.
# Use test keys only — never commit live secrets.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
